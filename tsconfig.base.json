{
  "compilerOptions": {
    "baseUrl": ".",
    "skipDefaultLibCheck": true,
    "declarationMap": false,
    "declaration": false,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@listedbase/source"],
    "paths": {
      "@listedbase/uni-reactive": ["packages/uni-reactive/core/src/index.ts"],
      "@listedbase/angular-reactive": [
        "packages/uni-reactive/adapters/angular-reactive/src/index.ts"
      ],
      "@listedbase/core": ["packages/core/src/index.ts"],
      "@listedbase/driver-abstract": [
        "./packages/drivers/abstract/src/index.ts"
      ],
      "@listedbase/supabase": ["./packages/drivers/supabase/src/index.ts"],
      "@listedbase/firestore": ["./packages/drivers/firestore/src/index.ts"],
      "@listedbase/indexeddb": ["./packages/drivers/indexeddb/src/index.ts"]
    }
  }
}
